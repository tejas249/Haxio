# "anthropic", "openai", or "groq" — picks which provider lib/ai/providers.ts
# uses for the agent. Groq has a free tier (console.groq.com, no card) if
# you want to test the chat without a paid key.
LLM_PROVIDER=anthropic

# Only the key for your chosen provider is required.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Optional: override the specific model id (defaults live in lib/ai/providers.ts)
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_MODEL=gpt-5.1
GROQ_MODEL=llama-3.3-70b-versatile

# Neon Postgres. `neon link` / `neon env pull` write this for you into
# .env.local — see README's Database section. A pooled connection string
# is what you want here (app code, not migrations).
DATABASE_URL=

# Dashboard login (lib/auth/session.ts). One shared admin password, not
# per-user accounts — proportionate to a one-admin internal dashboard.
ADMIN_PASSWORD=
# Random secret that signs the session cookie — generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
